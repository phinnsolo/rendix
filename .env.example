# Connection string de Neon (Vercel la crea sola con la integración de Neon).
DATABASE_URL=postgres://usuario:password@host/base?sslmode=require
# Cualquier texto largo y aleatorio: firma los tokens de sesión. Ej: openssl rand -hex 32
AUTH_SECRET=
# Sprint final: corrección automática con agentes jueces. Solo servidor: nunca se expone al frontend.
# Sin clave las entregas quedan "en cola" (el profesor ve el aviso y puede corregir a mano).
# Con GEMINI_API_KEY se usa Gemini (clave gratis en aistudio.google.com); si no, Claude con ANTHROPIC_API_KEY.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: forzar proveedor ("gemini" o "claude") y modelo (por defecto gemini-3.5-flash-lite / claude-opus-5-5).
# RENDIX_IA_PROVEEDOR=gemini
# RENDIX_IA_MODELO=gemini-3.5-flash-lite
# Solo Claude: "0" desactiva el modelo de respaldo ante rechazos.
# RENDIX_IA_FALLBACK=1
# Opcional: secreto para GET /api/correcciones/procesar (cron que retoma correcciones en cola).
# CRON_SECRET=
