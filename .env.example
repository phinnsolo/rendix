# Copiar este archivo como .env y completar los valores. NUNCA subir .env a GitHub.
# En Vercel estas variables se cargan en Project → Settings → Environment Variables.

# Neon — conexión POOLED (el host contiene "-pooler"). La usa la aplicación en runtime.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Neon — conexión DIRECTA (mismo host SIN "-pooler"). La usa solo Prisma Migrate.
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Base usada por los tests de integración (¡se vacía en cada corrida!).
# Usar una rama/base de Neon distinta (p. ej. una rama "test"). Solo hace falta en local.
TEST_DATABASE_URL="postgresql://USUARIO:CLAVE@ep-YYYY-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
TEST_DIRECT_URL="postgresql://USUARIO:CLAVE@ep-YYYY.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Secreto para firmar los JWT (mínimo 32 caracteres). Generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
