# Connection string de Neon (Vercel la crea sola con la integración de Neon).
DATABASE_URL=postgres://usuario:password@host/base?sslmode=require
# Cualquier texto largo y aleatorio: firma los tokens de sesión. Ej: openssl rand -hex 32
AUTH_SECRET=
# Sprint final: corrección automática con agentes jueces (API de Claude). Solo servidor: nunca se expone al frontend.
# Sin esta clave las entregas quedan "en cola" (el profesor ve el aviso y puede corregir a mano).
ANTHROPIC_API_KEY=
# Opcional: modelo de los jueces (por defecto claude-opus-5-5) y "0" para desactivar el modelo de respaldo ante rechazos.
# RENDIX_IA_MODELO=claude-opus-5-5
# RENDIX_IA_FALLBACK=1
# Opcional: secreto para GET /api/correcciones/procesar (cron que retoma correcciones en cola).
# CRON_SECRET=
